# Test environment variables for local pytest runs
# Copy this to .env.test and customize as needed

# Django
DEBUG=True
DJANGO_SECRET_KEY=test-secret-key-not-for-production
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (assumes local postgres running)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oscarr_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional - can be left empty for tests
DISCORD_TOKEN=test-token
PGCRYPTO_KEY=test-pgcrypto-key-32chars-long

# Logs/Backups (not needed for tests but required by settings)
LOGS_DIR=/tmp/logs
BACKUPS_LOCATION=/tmp/backups

# External services (can be left empty for unit tests)
PLEX_USERNAME=
PLEX_PASSWORD=
PLEX_SERVER_NAME=
RADARR_API_URL=
RADARR_API_KEY=
RADARR_ROOT_FOLDER_PATH=
RADARR_QUALITY_PROFILE_ID=
SEEDBOX_UN=
SEEDBOX_PW=
TMDB_TOKEN_V3=
